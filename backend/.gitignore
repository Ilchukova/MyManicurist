@'
# Системные файлы
.DS_Store
Thumbs.db

# Логи
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node
node_modules/

# Сборка
backend/dist/
frontend/dist/

# Prisma
backend/src/generated/prisma/

# Покрытие тестов
coverage/
.nyc_output/

# Файлы окружения
.env
**/.env
**/.env.*

# Разрешаем примеры конфигурации
!.env.example
!**/.env.example

# Production и development настройки frontend
!.env.production
!**/.env.production
!**/.env.development

# TypeScript
*.tsbuildinfo

# IDE
.vscode/
.vs/
.idea/
*.swp
*.swo
'@ | Set-Content -Encoding utf8 .gitignore